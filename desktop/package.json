{
  "name": "@sirene/desktop",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "bash scripts/download-pocketbase.sh",
    "dev": "bun run -F @sirene/client build && electrobun dev",
    "dev:watch": "electrobun dev --watch",
    "prebuild": "bash scripts/download-pocketbase.sh && bash scripts/setup-inference.sh",
    "build": "bun run -F @sirene/client build && electrobun build",
    "prebuild:release": "bash scripts/download-pocketbase.sh && bash scripts/setup-inference.sh",
    "build:release": "bun run -F @sirene/client build && electrobun build --env=stable"
  },
  "dependencies": {
    "@sirene/server": "workspace:*",
    "electrobun": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.7.3"
  }
}
